[Unit]
Description=Orderly stasis before this machine stops
Documentation=https://gitlab.prplanit.com/PrPlanIT/CryoSheep

# Shutdown ordering is the reverse of startup ordering. Ordering *after* these at
# boot is what makes this stop *before* them at shutdown — while the API server
# is still reachable, the mounts still exist, and the network is still up. Get
# this wrong and the teardown runs against a machine that can no longer reach
# anything it needs.
#
# Units that are not installed here are simply ignored, so one file serves a
# Kubernetes node and a Proxmox host without being told which it is.
Wants=network-online.target
After=network-online.target network.target
After=kubelet.service crio.service containerd.service
After=pve-cluster.service pve-guests.service ceph.target

[Service]
# The work is in ExecStop, which is what makes this fire however the machine is
# being stopped: poweroff, reboot, ACPI from `qm shutdown`, or the reboot inside
# ansible's patch cycle. systemd does not care why it is stopping a unit, and
# neither does this.
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/bin/cryosheep sleep

# Stop every guest in an order tier at once, rather than one at a time.
#
# Safe by construction: guestWaves only groups guests that share a tier, and
# guests share a tier precisely because the declared policy says neither waits on
# the other. Tiers still run strictly in sequence, so the dependency order the
# policy expresses is preserved exactly.
#
# Not optional on a UPS. The default is 1, and serial across the busiest host's
# ten running guests takes longer than the batteries last — measured 620s on
# Cosmos against 461s of runtime. Parallel within tier brings the same host to
# 260s. A serial run does not shut the estate down safely; it runs out of power
# partway through.
Environment=CRYOSHEEP_GUEST_CONCURRENCY=-1

# Startup-order ranges that stop together, in the sequence given.
#
# Tiers exist for startup dependency and for planned maintenance, where stopping
# one thing at a time is exactly the point. A power failure wants the estate's
# real dependency shape instead, which is far coarser: guest disks reach Ceph
# over L2, but Kubernetes PVC traffic is routed through the firewall, so
# Kubernetes is the only tier needing other tiers still standing while it drains.
#
#   5-99  leaves and unordered — nothing depends on them
#   4     kubernetes — the one tier that does
#   2-3   DNS and storage — mutually independent
#   1     routers — alone, because anything still draining over a routed path
#         has no other way to reach its disk
#
# Ranges must cover 1..99 or the whole value is discarded and every tier becomes
# its own wave again: a guest in no range would be a guest left running.
# Commented out until Drill B: a planned shutdown wants the careful shape, and
# this changes what happens on every reboot, not only on battery.
#Environment=CRYOSHEEP_ORDER_GROUPS=5-99,4,2-3,1

# Inside the UPS envelope on purpose. The backstop has to fire while there is
# still power to halt on, so it is set below the measured 461s runtime rather
# than above it: a timeout the batteries outlive is not a backstop. 420s clears
# the slowest host's realistic sequence (Avocado, 370s including host halt) with
# margin, and cuts losses on anything pathological rather than waiting for the
# power to decide.
TimeoutStopSec=420s

# The one policy number, and the only thing here worth editing per host. It is
# the deadline after which the UPS cuts power regardless of what finished — take
# it from `cryosheep calibrate`, never guess it. Unset means no hardware backstop.
#Environment=CRYOSHEEP_UPS_DEADLINE=5m30s

# Only needed where the node's own kubelet.conf is not the right identity;
# CryoSheep finds /etc/kubernetes/kubelet.conf on its own.
#Environment=CRYOSHEEP_KUBECONFIG=/etc/kubernetes/admin.conf

[Install]
WantedBy=multi-user.target
